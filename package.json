{
  "name": "shreevikas-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run knowledge:prepare && next dev",
    "build": "npm run knowledge:prepare && next build && tsx scripts/check-chat-bundle.ts",
    "knowledge:prepare": "tsx scripts/prepare-knowledge.ts",
    "knowledge:sync": "tsx scripts/sync-knowledge.ts",
    "pretest": "npm run knowledge:prepare",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:visuals": "tsx scripts/test-brain-circuit.ts",
    "test": "node scripts/test-chat-route.mjs && node --conditions=react-server --import tsx scripts/test-retrieval.ts && node --conditions=react-server --import tsx scripts/evaluate-chatbot.ts",
    "test:chatbot:live": "npm run knowledge:prepare && node --conditions=react-server --import tsx scripts/evaluate-chatbot-live.ts --confirm-live"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "faiss-node": "^0.5.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "streamdown": "^2.7.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "faiss-node@0.5.1": true,
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.30.0": true
  }
}
